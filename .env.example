# Likes are stored in Upstash Redis. Add "Upstash Redis" to the Vercel project
# from the Marketplace and these are injected automatically. Leave them unset
# locally to use the in-memory store (counts reset when the dev server restarts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The site's canonical origin, used to build absolute Open Graph / Twitter URLs
# for link previews. On Vercel it falls back to the deployment URL automatically;
# set this to your custom domain (e.g. https://ganapati.example.com) so previews
# point at the right host. Leave unset locally.
NEXT_PUBLIC_SITE_URL=
